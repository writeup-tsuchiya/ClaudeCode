# 要件定義書 §5 —— 最初に作ること。
# 一度コミットすると .gitignore に足しても履歴からは消えません。

.env
*token*.json
credentials/

# 🔴 他人の顔・声・個人情報（§11）
#    ここに例外（!）を書かないこと。
#    git は「親ディレクトリが除外されているファイル」を再包含できないため、
#    例外を効かせようとすると assets/people/ 自体の除外を緩めることになり、
#    実在の人物の写真と音声が履歴に入る事故につながります。
#    配布用のひな形は samples/person-template/ に置いてあります。
assets/people/

# 作業場と成果物
runs/
logs/

# AIモデル本体（数GB）
vendor/

*.mp4
*.wav

# 各エンジンの専用環境（§6-3 / §8-2 / §7-7）
.venv-*
__pycache__/
*.pyc
